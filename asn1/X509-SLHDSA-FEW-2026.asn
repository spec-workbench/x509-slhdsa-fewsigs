  sa-hash-slh-dsa-sha2-128-24-with-sha256.&smimeCaps |
  sa-hash-slh-dsa-shake-128-24-with-shake128.&smimeCaps |
  sa-hash-slh-dsa-sha2-192-24-with-sha512.&smimeCaps |
