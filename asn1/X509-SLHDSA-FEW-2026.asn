--
-- Pure SLH-DSA-FEW signature algorithm identifiers
--

sa-slh-dsa-sha2-128-24 SIGNATURE-ALGORITHM ::= {
  IDENTIFIER id-slh-dsa-sha2-128-24
  PARAMS ARE absent
  PUBLIC-KEYS { pk-slh-dsa-sha2-128-24 }
  SMIME-CAPS {
    IDENTIFIED BY id-slh-dsa-sha2-128-24 } }

sa-slh-dsa-shake-128-24 SIGNATURE-ALGORITHM ::= {
